FLASK_ENV=development

SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string

# Leave unset locally to use SQLite fallback. Set for PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://attendance_user:attendance_pass@localhost:5432/attendance_db

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
